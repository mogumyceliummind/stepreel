{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * *:refs/heads/main*)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push * *:main)",
      "Bash(git -C * push * *:main *)",
      "Bash(git -C * push * *:refs/heads/main*)",
      "Bash(gh pr merge*)"
    ]
  }
}
